spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/gollagolla?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD

  jpa:
    properties:
      hibernate:
        show_sql: true
        format_sql: false
        highlight_sql: true

  flyway:
    enabled: true
    locations: classpath:db/migration

oauth:
  kakao:
    client-id: ${KAKAO_CLIENT_ID:your-kakao-client-id}
    redirect-uri: ${KAKAO_REDIRECT_URI:http://localhost:3000/oauth/callback/kakao}
  naver:
    client-id: ${NAVER_CLIENT_ID:your-naver-client-id}
    client-secret: ${NAVER_CLIENT_SECRET:your-naver-client-secret}
  google:
    client-id: ${GOOGLE_CLIENT_ID:your-google-client-id}
    client-secret: ${GOOGLE_CLIENT_SECRET:your-google-client-secret}
    redirect-uri: ${GOOGLE_REDIRECT_URI:http://localhost:3000/oauth/callback/google}

tourapi:
  service-key: ${TOUR_API_KEY:your-tour-api-key}
  base-url: https://apis.data.go.kr/B551011/KorService2
  auto-sync: false
  target-area-codes:

  ai:
    google:
      genai:
        api-key: ${GEMINI_API_KEY:your-gemini-api-key}
        chat:
          options:
            model: gemini-1.5-pro